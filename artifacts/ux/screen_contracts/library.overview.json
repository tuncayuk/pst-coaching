{
  "id": "library.overview",
  "title": "Kutuphane",
  "route": "/library",
  "purpose": "Tab root screen for Kutuphane.",
  "entryPoints": ["app.launch"],
  "inputs": [
    {
      "name": "locale",
      "type": "LanguageCode",
      "required": true,
      "source": "profile"
    },
    {
      "name": "subscriptionStatus",
      "type": "SubscriptionStatus",
      "required": true,
      "source": "entitlement_cache"
    }
  ],
  "dataDependencies": ["User", "Subscription", "ContentProgress"],
  "uiStates": {
    "loading": {
      "description": "Tab shows skeleton cards while initial data is loading."
    },
    "ready": {
      "description": "Tab content is visible and interactive."
    },
    "empty": {
      "description": "Tab-specific empty state with CTA is displayed."
    },
    "error": {
      "description": "Tab-level error UI appears with retry action."
    },
    "offline": {
      "description": "Last cache is shown with offline indicator."
    }
  },
  "analytics": {
    "screenView": "library_overview_viewed",
    "events": [
      "library_overview_viewed",
      "library_favorites_tapped",
      "library_collections_tapped",
      "library_create_collection_tapped"
    ]
  },
  "leadsTo": ["library.favorites", "library.collections", "library.downloads"],
  "acceptanceCriteriaRefs": [
    "AC-FR-E9-01-01",
    "AC-FR-E9-01-02",
    "AC-FR-E7-01-01",
    "AC-LIB-01-01",
    "AC-LIB-01-02",
    "AC-LIB-01-03"
  ],
  "gates": ["subscription"]
}
