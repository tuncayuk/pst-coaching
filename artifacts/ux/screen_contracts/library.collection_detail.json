{
  "id": "library.collection_detail",
  "title": "Koleksiyon Detay",
  "route": "/library/collections/:id",
  "purpose": "Koleksiyon içeriğini yönetmek.",
  "entryPoints": [
    "library.overview"
  ],
  "inputs": [
    {
      "name": "locale",
      "type": "LanguageCode",
      "required": true,
      "source": "app_state"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "source": "route"
    }
  ],
  "dataDependencies": [
    "ContentProgress",
    "Favorite",
    "Collection",
    "Download",
    "EbookProgress",
    "Highlight",
    "Note"
  ],
  "uiStates": {
    "loading": {
      "description": "Koleksiyon Detay yüklenirken iskelet ve temel CTA'lar gösterilir."
    },
    "ready": {
      "description": "Koleksiyon Detay içeriği ve etkileşimler hazır."
    },
    "empty": {
      "description": "İçerik yoksa açıklayıcı boş durum ve birincil aksiyon sunulur."
    },
    "error": {
      "description": "Hata mesajı ve tekrar dene aksiyonu gösterilir."
    },
    "offline": {
      "description": "Çevrimdışı modda önbellek içerik gösterilir, senkron bekler."
    }
  },
  "analytics": {
    "screenView": "library_collection_detail_viewed",
    "events": [
      "library_collection_detail_viewed"
    ]
  },
  "acceptanceCriteriaRefs": [
    "RQ-12"
  ],
  "gates": [
    "subscription:trial_or_active"
  ]
}