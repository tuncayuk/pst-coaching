{
  "id": "content.reader",
  "title": "Reading",
  "type": "stack",
  "route": "/content/:type/:id/reader",
  "purpose": "Read content units with highlights, audio, and progress.",
  "entryPoints": [
    "discover.start_content",
    "home.dashboard",
    "journey.detail",
    "workshop.detail"
  ],
  "inputs": [
    {
      "name": "type",
      "type": "string",
      "required": true,
      "source": "route"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "source": "route"
    }
  ],
  "dataDependencies": [
    "ContentUnit",
    "UnitProgress",
    "Submission",
    "Highlight",
    "UserProgress"
  ],
  "uiStates": {
    "loading": {
      "description": "Show skeletons and prevent destructive actions.",
      "actions": [
        "retry_fetch_if_timeout"
      ]
    },
    "ready": {
      "description": "Primary content is visible and interactive."
    },
    "empty": {
      "description": "No data available; show guidance and a primary CTA."
    },
    "error": {
      "description": "Display error message with retry and support options."
    },
    "offline": {
      "description": "Show offline banner; use cached content when possible."
    }
  },
  "analytics": {
    "screen_viewed": "content_reader_viewed",
    "events": [
      "highlight_added",
      "audio_play_started"
    ]
  },
  "acRefs": [
    "requirements:Reading and interaction"
  ],
  "gates": [
    "subscription_active_or_trial"
  ]
}
