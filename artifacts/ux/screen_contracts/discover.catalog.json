{
  "id": "discover.catalog",
  "title": "Kesfet",
  "route": "/discover",
  "purpose": "Tab root screen for Kesfet.",
  "entryPoints": ["app.launch"],
  "inputs": [
    {
      "name": "locale",
      "type": "LanguageCode",
      "required": true,
      "source": "profile"
    },
    {
      "name": "subscriptionStatus",
      "type": "SubscriptionStatus",
      "required": true,
      "source": "entitlement_cache"
    }
  ],
  "dataDependencies": ["User", "Subscription", "ContentProgress"],
  "uiStates": {
    "loading": {
      "description": "Tab shows skeleton cards while initial data is loading."
    },
    "ready": {
      "description": "Tab content is visible and interactive."
    },
    "empty": {
      "description": "Tab-specific empty state with CTA is displayed."
    },
    "error": {
      "description": "Tab-level error UI appears with retry action."
    },
    "offline": {
      "description": "Last cache is shown with offline indicator."
    }
  },
  "analytics": {
    "screenView": "discover_catalog_viewed",
    "events": [
      "discover_catalog_viewed",
      "discover_tab_tapped",
      "discover_journey_card_tapped",
      "discover_ebook_card_tapped",
      "discover_assistant_tapped",
      "discover_paywall_trigger"
    ]
  },
  "leadsTo": [
    "discover.journeys",
    "discover.workshops",
    "discover.modules",
    "discover.ebooks",
    "discover.assistant_intro",
    "content.journey_detail",
    "content.ebook_detail",
    "content.paywall"
  ],
  "acceptanceCriteriaRefs": ["AC-FR-E4-01-01", "AC-FR-E4-01-02", "AC-FR-E4-01-03"],
  "gates": []
}
