{
  "id": "content.workshop_detail",
  "title": "Atölye Detay",
  "route": "/content/workshops/:id",
  "purpose": "Atölye Detay deneyimini sunmak.",
  "entryPoints": [
    "content.* detail/home screens"
  ],
  "inputs": [
    {
      "name": "locale",
      "type": "LanguageCode",
      "required": true,
      "source": "app_state"
    },
    {
      "name": "id",
      "type": "string",
      "required": true,
      "source": "route"
    }
  ],
  "dataDependencies": [
    "ContentItem",
    "ContentProgress",
    "Comment",
    "Highlight",
    "Note",
    "Achievement",
    "Download",
    "DemographicProfile",
    "Journey",
    "JourneyDay",
    "Workshop",
    "Module",
    "Package",
    "Ebook",
    "EbookProgress"
  ],
  "uiStates": {
    "loading": {
      "description": "Atölye Detay yüklenirken iskelet ve temel CTA'lar gösterilir."
    },
    "ready": {
      "description": "Atölye Detay içeriği ve etkileşimler hazır; demografi eksikse baslatmadan once form tetiklenir."
    },
    "empty": {
      "description": "İçerik yoksa açıklayıcı boş durum ve birincil aksiyon sunulur."
    },
    "error": {
      "description": "Hata mesajı ve tekrar dene aksiyonu gösterilir."
    },
    "offline": {
      "description": "Çevrimdışı modda önbellek içerik gösterilir, senkron bekler."
    }
  },
  "analytics": {
    "screenView": "content_workshop_detail_viewed",
    "events": [
      "content_workshop_detail_viewed",
      "demographics_gate_triggered",
      "demographics_form_opened"
    ]
  },
  "acceptanceCriteriaRefs": [
    "RQ-07",
    "RQ-08",
    "RQ-09",
    "RQ-10",
    "RQ-11"
  ],
  "gates": []
}
