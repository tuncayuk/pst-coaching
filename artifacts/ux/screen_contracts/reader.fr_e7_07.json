{
  "id": "reader.fr_e7_07",
  "title": "Okuma ilerlemesi",
  "route": "/ebook/progress",
  "purpose": "Implements FR-E7-07: Ilerleme yüzdesi, kalan süre tahmini, tamamlanma rozeti/sertifikasi, Gelisim paneli yansimasi.",
  "entryPoints": [
    "library.ebooks",
    "ebook.detail"
  ],
  "inputs": [
    {
      "name": "ebookId",
      "type": "string",
      "required": true,
      "source": "route_param"
    },
    {
      "name": "userId",
      "type": "uuid",
      "required": true,
      "source": "session"
    }
  ],
  "dataDependencies": [
    "ContentProgress",
    "EbookProgress",
    "Achievement"
  ],
  "uiStates": {
    "loading": {
      "description": "Skeleton progress bars."
    },
    "ready": {
      "description": "Progress percentage (AC-FR-E7-07-01). Estimated remaining time (AC-FR-E7-07-02). Completion badge/certificate CTA when finished (AC-FR-E7-07-03). Progress reflected in ProgressDashboard (AC-FR-E7-07-04)."
    },
    "empty": {
      "description": "No reading started yet; CTA to begin reading."
    },
    "error": {
      "description": "Error loading progress; retry."
    },
    "offline": {
      "description": "Last synced progress shown."
    }
  },
  "analytics": {
    "screenView": "ebook_progress_viewed",
    "events": [
      "ebook_progress_viewed",
      "ebook_completion_badge_claimed",
      "ebook_reading_started"
    ]
  },
  "acceptanceCriteriaRefs": [
    "AC-FR-E7-07-01",
    "AC-FR-E7-07-02",
    "AC-FR-E7-07-03",
    "AC-FR-E7-07-04"
  ],
  "gates": [
    "auth"
  ]
}