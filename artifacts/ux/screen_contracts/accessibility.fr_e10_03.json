{
  "id": "accessibility.fr_e10_03",
  "title": "Yuksek kontrast ve tema",
  "route": "/accessibility/theme",
  "purpose": "Implements FR-E10-03: Tema secimi (Acik/Koyu/Sistem), yuksek kontrast 7:1, renk koru deseni.",
  "entryPoints": ["profile.accessibility", "accessibility.fr_e10_01"],
  "inputs": [
    {
      "name": "userId",
      "type": "uuid",
      "required": true,
      "source": "session"
    },
    {
      "name": "currentTheme",
      "type": "string",
      "required": false,
      "source": "accessibility_settings"
    }
  ],
  "dataDependencies": ["AccessibilitySettings"],
  "uiStates": {
    "loading": {
      "description": "Skeleton shown while loading theme and contrast settings."
    },
    "ready": {
      "description": "Theme radio group (Acik/Koyu/Sistem), high contrast toggle, color blindness mode chips."
    },
    "empty": {
      "description": "Default System theme shown."
    },
    "error": {
      "description": "Error state with retry CTA."
    },
    "offline": {
      "description": "Last saved theme shown; changes queued for sync."
    }
  },
  "analytics": {
    "screenView": "theme_settings_viewed",
    "events": ["theme_settings_viewed", "theme_changed", "high_contrast_toggled", "color_blind_mode_changed"]
  },
  "acceptanceCriteriaRefs": ["AC-FR-E10-03-01", "AC-FR-E10-03-02", "AC-FR-E10-03-03"],
  "gates": ["auth"]
}
