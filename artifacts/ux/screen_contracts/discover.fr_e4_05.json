{
  "id": "discover.fr_e4_05",
  "title": "Modul Katalogu ve Detayi",
  "route": "/discover/modules",
  "purpose": "Implements FR-E4-05: Module catalog with sort, topic filter (Gelisim/Maneviyat/Denge), package count, preview package list with descriptions, and Modulu Baslat CTA.",
  "entryPoints": [
    "discover.fr_e4_01"
  ],
  "inputs": [
    {
      "name": "userId",
      "type": "uuid",
      "required": false,
      "source": "session"
    },
    {
      "name": "subscriptionStatus",
      "type": "SubscriptionStatus",
      "required": false,
      "source": "entitlement_cache"
    },
    {
      "name": "locale",
      "type": "LanguageCode",
      "required": true,
      "source": "profile"
    }
  ],
  "dataDependencies": [
    "Module",
    "Package"
  ],
  "uiStates": {
    "loading": {
      "description": "Skeleton cards while loading modules."
    },
    "ready": {
      "description": "Sort chips + topic filter chips + module cards. Card shows: title, description, package count chip, top-2 package preview with index badges and short descriptions, 'Modulu Baslat' CTA. Empty-filter state when filter yields 0."
    },
    "empty": {
      "description": "Empty state with notification opt-in."
    },
    "error": {
      "description": "Error state with retry action."
    },
    "offline": {
      "description": "Cached modules shown with filters disabled."
    }
  },
  "analytics": {
    "screenView": "discover_modules_viewed",
    "events": [
      "discover_modules_viewed",
      "discover_modules_sort_changed",
      "discover_modules_topic_filtered",
      "discover_module_card_tapped",
      "discover_module_start_tapped"
    ]
  },
  "acceptanceCriteriaRefs": [
    "AC-FR-E4-05-01",
    "AC-FR-E4-05-02",
    "AC-FR-E4-05-03",
    "AC-FR-E4-05-04"
  ],
  "gates": []
}
