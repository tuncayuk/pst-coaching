{
  "content_progression": {
    "description": "Locked progression for journeys, modules, packages, and workshop nodes.",
    "initial_state": "locked",
    "states": [
      "locked",
      "available",
      "in_progress",
      "completed"
    ],
    "transitions": [
      {
        "from": "locked",
        "to": "available",
        "trigger": "prerequisite_completed_or_server_unlock"
      },
      {
        "from": "available",
        "to": "in_progress",
        "trigger": "user_starts_content"
      },
      {
        "from": "in_progress",
        "to": "completed",
        "trigger": "all_required_steps_completed"
      }
    ]
  },
  "day_cycle_rules": {
    "description": "Daily content unlock by user timezone at 08:00 and submission deadline at 23:59, with server time authority.",
    "initial_state": "locked_until_08_00",
    "states": [
      "locked_until_08_00",
      "open_for_progress",
      "submission_warning_23_00",
      "submission_closed",
      "next_day_pending"
    ],
    "transitions": [
      {
        "from": "locked_until_08_00",
        "to": "open_for_progress",
        "trigger": "server_time_reaches_08_00"
      },
      {
        "from": "open_for_progress",
        "to": "submission_warning_23_00",
        "trigger": "server_time_reaches_23_00"
      },
      {
        "from": "submission_warning_23_00",
        "to": "submission_closed",
        "trigger": "server_time_reaches_23_59"
      },
      {
        "from": "submission_closed",
        "to": "next_day_pending",
        "trigger": "day_rollover"
      },
      {
        "from": "next_day_pending",
        "to": "locked_until_08_00",
        "trigger": "next_day_initialized"
      }
    ],
    "authority": "server_time"
  },
  "subscription_entitlement_gating": {
    "description": "Authorization gate for protected tabs and content start flow.",
    "initial_state": "inactive",
    "states": [
      "inactive",
      "trial",
      "active",
      "canceled"
    ],
    "transitions": [
      {
        "from": "inactive",
        "to": "trial",
        "trigger": "trial_started"
      },
      {
        "from": "inactive",
        "to": "active",
        "trigger": "purchase_validated_server_side"
      },
      {
        "from": "trial",
        "to": "active",
        "trigger": "trial_converted"
      },
      {
        "from": "active",
        "to": "canceled",
        "trigger": "cancel_requested"
      },
      {
        "from": "trial",
        "to": "canceled",
        "trigger": "trial_canceled"
      },
      {
        "from": "canceled",
        "to": "inactive",
        "trigger": "period_end_reached"
      },
      {
        "from": "canceled",
        "to": "active",
        "trigger": "restore_purchase_success"
      }
    ],
    "notes": [
      "Cancellation keeps access until period_end_reached."
    ]
  },
  "workshop_stage_progression": {
    "description": "Stage-level progression for Rev4 workshop structure (stages 1-11 with typed layers and lock reasons).",
    "initial_state": "locked",
    "states": [
      "locked",
      "available",
      "in_progress",
      "completed"
    ],
    "transitions": [
      {
        "from": "locked",
        "to": "available",
        "trigger": "previous_stage_completed_or_rule_opened"
      },
      {
        "from": "available",
        "to": "in_progress",
        "trigger": "user_enters_stage"
      },
      {
        "from": "in_progress",
        "to": "completed",
        "trigger": "required_outputs_saved"
      }
    ],
    "constraints": [
      "Lock reason must be shown to user.",
      "Stage type controls UI blocks and expected outputs."
    ]
  },
  "workshop_session_progression": {
    "description": "Camp session lifecycle for day/slot sessions in Stage 8.",
    "initial_state": "locked",
    "states": [
      "locked",
      "scheduled",
      "in_progress",
      "completed",
      "missed"
    ],
    "transitions": [
      {
        "from": "locked",
        "to": "scheduled",
        "trigger": "session_open_condition_met"
      },
      {
        "from": "scheduled",
        "to": "in_progress",
        "trigger": "session_started"
      },
      {
        "from": "in_progress",
        "to": "completed",
        "trigger": "session_output_saved"
      },
      {
        "from": "scheduled",
        "to": "missed",
        "trigger": "session_window_expired"
      }
    ],
    "notes": [
      "Completion updates stage summary and recommends next session."
    ]
  },
  "workbook_entry_lifecycle": {
    "description": "Autosave and versioned persistence for workbook and worksheet entries.",
    "initial_state": "draft",
    "states": [
      "draft",
      "saved",
      "submitted",
      "archived"
    ],
    "transitions": [
      {
        "from": "draft",
        "to": "saved",
        "trigger": "autosave_or_manual_save"
      },
      {
        "from": "saved",
        "to": "submitted",
        "trigger": "user_confirms_submission"
      },
      {
        "from": "saved",
        "to": "draft",
        "trigger": "user_edits_again"
      },
      {
        "from": "submitted",
        "to": "archived",
        "trigger": "workshop_archived"
      }
    ],
    "constraints": [
      "Entries are versioned by workshop/stage/session context.",
      "Export requires explicit privacy consent."
    ]
  }
}
