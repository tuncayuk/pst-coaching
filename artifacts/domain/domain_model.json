{
  "app": {
    "name": "PST Coaching",
    "version": "1.1"
  },
  "entities": [
    {
      "name": "User",
      "description": "Account holder for PST Mobile.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "email", "type": "string", "required": false},
        {"name": "phone", "type": "string", "required": false},
        {"name": "password_hash", "type": "string", "required": false},
        {"name": "role", "type": "UserRole", "required": true},
        {"name": "language", "type": "LanguageCode", "required": true},
        {"name": "created_at", "type": "datetime", "required": true},
        {"name": "status", "type": "UserStatus", "required": true}
      ]
    },
    {
      "name": "UserSession",
      "description": "Authenticated session state and expiry.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "token", "type": "string", "required": true},
        {"name": "expires_at", "type": "datetime", "required": true},
        {"name": "last_active_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "AccessibilitySettings",
      "description": "User accessibility preferences.",
      "fields": [
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "text_size", "type": "string", "required": true},
        {"name": "high_contrast", "type": "boolean", "required": true},
        {"name": "reduce_motion", "type": "boolean", "required": true},
        {"name": "theme", "type": "ThemeMode", "required": true}
      ]
    },
    {
      "name": "ReadingSettings",
      "description": "e-Kitap reader settings persisted across books.",
      "fields": [
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "font_size", "type": "integer", "required": true},
        {"name": "line_height", "type": "string", "required": true},
        {"name": "background", "type": "ReaderBackground", "required": true}
      ]
    },
    {
      "name": "ReminderSettings",
      "description": "Daily reminder preferences.",
      "fields": [
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "enabled", "type": "boolean", "required": true},
        {"name": "time_local", "type": "time", "required": true},
        {"name": "last_sent_at", "type": "datetime", "required": false}
      ]
    },
    {
      "name": "SubscriptionPlan",
      "description": "Commercial plan definition.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "plan_type", "type": "PlanType", "required": true},
        {"name": "seat_limit", "type": "integer", "required": true},
        {"name": "student_discount_eligible", "type": "boolean", "required": true}
      ]
    },
    {
      "name": "Subscription",
      "description": "User subscription instance tied to a plan.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "owner_user_id", "type": "uuid", "required": true},
        {"name": "plan_id", "type": "uuid", "required": true},
        {"name": "status", "type": "SubscriptionStatus", "required": true},
        {"name": "started_at", "type": "datetime", "required": true},
        {"name": "renewal_at", "type": "datetime", "required": false},
        {"name": "ends_at", "type": "datetime", "required": false},
        {"name": "platform", "type": "StorePlatform", "required": true},
        {"name": "student_discount_applied", "type": "boolean", "required": true}
      ]
    },
    {
      "name": "AddOn",
      "description": "Optional add-on product.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "code", "type": "AddOnCode", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "eligible_plan_types", "type": "PlanType[]", "required": true}
      ]
    },
    {
      "name": "SubscriptionAddOn",
      "description": "Add-on activation for a subscription.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "subscription_id", "type": "uuid", "required": true},
        {"name": "addon_id", "type": "uuid", "required": true},
        {"name": "status", "type": "AddOnStatus", "required": true},
        {"name": "activated_at", "type": "datetime", "required": false},
        {"name": "deactivated_at", "type": "datetime", "required": false}
      ]
    },
    {
      "name": "Seat",
      "description": "Seat allocation for family/group plans.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "subscription_id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": false},
        {"name": "status", "type": "SeatStatus", "required": true}
      ]
    },
    {
      "name": "Invitation",
      "description": "Invite to join a subscription seat.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "subscription_id", "type": "uuid", "required": true},
        {"name": "invitee_contact", "type": "string", "required": true},
        {"name": "status", "type": "InvitationStatus", "required": true},
        {"name": "sent_at", "type": "datetime", "required": true},
        {"name": "accepted_at", "type": "datetime", "required": false}
      ]
    },
    {
      "name": "PaymentTransaction",
      "description": "Store purchase record for restore/history.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "subscription_id", "type": "uuid", "required": true},
        {"name": "store_transaction_id", "type": "string", "required": true},
        {"name": "amount", "type": "decimal", "required": true},
        {"name": "currency", "type": "string", "required": true},
        {"name": "purchased_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Journey",
      "description": "Prebuilt program created by PST coaches.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "description", "type": "string", "required": false},
        {"name": "level", "type": "string", "required": false},
        {"name": "duration_days", "type": "integer", "required": false},
        {"name": "daily_target", "type": "string", "required": false},
        {"name": "language", "type": "LanguageCode", "required": true}
      ]
    },
    {
      "name": "JourneyDay",
      "description": "Day-based content within a journey.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "journey_id", "type": "uuid", "required": true},
        {"name": "day_number", "type": "integer", "required": true},
        {"name": "title", "type": "string", "required": false},
        {"name": "unlock_time_local", "type": "time", "required": true}
      ]
    },
    {
      "name": "Module",
      "description": "Thematic module containing packages.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "description", "type": "string", "required": false},
        {"name": "language", "type": "LanguageCode", "required": true}
      ]
    },
    {
      "name": "Package",
      "description": "Module sub-unit with readings and exercises.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "module_id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "description", "type": "string", "required": false},
        {"name": "order_index", "type": "integer", "required": true}
      ]
    },
    {
      "name": "Workshop",
      "description": "Interactive workshop with reading and exercises.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "description", "type": "string", "required": false},
        {"name": "language", "type": "LanguageCode", "required": true}
      ]
    },
    {
      "name": "Ebook",
      "description": "Digital book within PST library.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "category", "type": "string", "required": false},
        {"name": "total_pages", "type": "integer", "required": true},
        {"name": "has_audio", "type": "boolean", "required": true},
        {"name": "language", "type": "LanguageCode", "required": true}
      ]
    },
    {
      "name": "EbookChapter",
      "description": "Chapter or section within an e-book.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "ebook_id", "type": "uuid", "required": true},
        {"name": "title", "type": "string", "required": true},
        {"name": "order_index", "type": "integer", "required": true},
        {"name": "page_start", "type": "integer", "required": false},
        {"name": "page_end", "type": "integer", "required": false}
      ]
    },
    {
      "name": "ContentItem",
      "description": "Atomic content item used in packages, workshops, or journey days.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "parent_type", "type": "ContentParentType", "required": true},
        {"name": "parent_id", "type": "uuid", "required": true},
        {"name": "content_type", "type": "ContentItemType", "required": true},
        {"name": "title", "type": "string", "required": false},
        {"name": "body", "type": "string", "required": false},
        {"name": "order_index", "type": "integer", "required": true},
        {"name": "has_audio", "type": "boolean", "required": false}
      ]
    },
    {
      "name": "ExerciseStep",
      "description": "Step within an exercise/application content item.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "content_item_id", "type": "uuid", "required": true},
        {"name": "step_number", "type": "integer", "required": true},
        {"name": "text", "type": "string", "required": true}
      ]
    },
    {
      "name": "ContentProgress",
      "description": "User progression over content items or parents.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "content_type", "type": "ProgressTargetType", "required": true},
        {"name": "content_id", "type": "uuid", "required": true},
        {"name": "status", "type": "ProgressStatus", "required": true},
        {"name": "started_at", "type": "datetime", "required": false},
        {"name": "completed_at", "type": "datetime", "required": false}
      ]
    },
    {
      "name": "Comment",
      "description": "User written response to guided questions.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "content_item_id", "type": "uuid", "required": true},
        {"name": "text", "type": "string", "required": true},
        {"name": "status", "type": "CommentStatus", "required": true},
        {"name": "word_count", "type": "integer", "required": false},
        {"name": "submitted_at", "type": "datetime", "required": false},
        {"name": "updated_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Highlight",
      "description": "Highlighted text range within content.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "source_type", "type": "HighlightSourceType", "required": true},
        {"name": "source_id", "type": "uuid", "required": true},
        {"name": "quote", "type": "string", "required": true},
        {"name": "color", "type": "string", "required": false},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Note",
      "description": "User note attached to a highlight or content.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "highlight_id", "type": "uuid", "required": false},
        {"name": "source_type", "type": "HighlightSourceType", "required": true},
        {"name": "source_id", "type": "uuid", "required": true},
        {"name": "text", "type": "string", "required": true},
        {"name": "updated_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Favorite",
      "description": "Saved user item (highlight/note/content).",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "item_type", "type": "FavoriteItemType", "required": true},
        {"name": "item_id", "type": "uuid", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Collection",
      "description": "User-defined grouping of favorites.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "name", "type": "string", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "CollectionItem",
      "description": "Mapping of favorites into collections.",
      "fields": [
        {"name": "collection_id", "type": "uuid", "required": true},
        {"name": "favorite_id", "type": "uuid", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "EbookProgress",
      "description": "Reading progress for an e-book.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "ebook_id", "type": "uuid", "required": true},
        {"name": "current_page", "type": "integer", "required": true},
        {"name": "progress_percent", "type": "integer", "required": true},
        {"name": "last_read_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Download",
      "description": "Offline download record for content.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "content_type", "type": "DownloadContentType", "required": true},
        {"name": "content_id", "type": "uuid", "required": true},
        {"name": "status", "type": "DownloadStatus", "required": true},
        {"name": "size_bytes", "type": "integer", "required": false},
        {"name": "updated_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "Achievement",
      "description": "Certificate or badge issued after completion.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "type", "type": "AchievementType", "required": true},
        {"name": "source_type", "type": "AchievementSourceType", "required": true},
        {"name": "source_id", "type": "uuid", "required": true},
        {"name": "issued_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "ContentReview",
      "description": "Post-completion evaluation prompt results.",
      "fields": [
        {"name": "id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "required": true},
        {"name": "content_type", "type": "ReviewTargetType", "required": true},
        {"name": "content_id", "type": "uuid", "required": true},
        {"name": "response", "type": "string", "required": true},
        {"name": "submitted_at", "type": "datetime", "required": true}
      ]
    },
    {
      "name": "CoachAssignment",
      "description": "Coach to client mapping (Phase 2).",
      "fields": [
        {"name": "coach_user_id", "type": "uuid", "required": true},
        {"name": "client_user_id", "type": "uuid", "required": true},
        {"name": "created_at", "type": "datetime", "required": true}
      ]
    }
  ],
  "enums": [
    {"name": "LanguageCode", "values": ["tr", "en", "es"]},
    {"name": "UserRole", "values": ["plan_owner", "plan_member", "coach"]},
    {"name": "UserStatus", "values": ["active", "disabled"]},
    {"name": "ThemeMode", "values": ["system", "light", "dark"]},
    {"name": "ReaderBackground", "values": ["white", "sepia", "dark"]},
    {"name": "PlanType", "values": ["individual", "family", "group"]},
    {"name": "SubscriptionStatus", "values": ["trial", "active", "canceled", "inactive"]},
    {"name": "StorePlatform", "values": ["apple", "google"]},
    {"name": "AddOnCode", "values": ["ai_package", "coaching_training", "extra_seats_5", "extra_seats_10"]},
    {"name": "AddOnStatus", "values": ["active", "inactive"]},
    {"name": "SeatStatus", "values": ["available", "invited", "active", "removed"]},
    {"name": "InvitationStatus", "values": ["pending", "accepted", "expired", "revoked"]},
    {"name": "ContentParentType", "values": ["journey_day", "package", "workshop"]},
    {"name": "ContentItemType", "values": ["reading", "exercise", "question"]},
    {"name": "ProgressTargetType", "values": ["journey_day", "package", "workshop", "module", "journey", "ebook"]},
    {"name": "ProgressStatus", "values": ["locked", "available", "in_progress", "completed"]},
    {"name": "CommentStatus", "values": ["draft", "submitted", "locked"]},
    {"name": "HighlightSourceType", "values": ["ebook", "workshop", "package", "journey_day"]},
    {"name": "FavoriteItemType", "values": ["highlight", "note", "content"]},
    {"name": "DownloadContentType", "values": ["ebook", "workshop", "package", "journey"]},
    {"name": "DownloadStatus", "values": ["queued", "downloading", "downloaded", "failed"]},
    {"name": "AchievementType", "values": ["badge", "certificate"]},
    {"name": "AchievementSourceType", "values": ["workshop", "module", "journey", "ebook"]},
    {"name": "ReviewTargetType", "values": ["workshop", "module", "journey"]}
  ],
  "relationships": [
    {"from": "User", "to": "UserSession", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "AccessibilitySettings", "type": "one_to_one", "field": "user_id"},
    {"from": "User", "to": "ReadingSettings", "type": "one_to_one", "field": "user_id"},
    {"from": "User", "to": "ReminderSettings", "type": "one_to_one", "field": "user_id"},
    {"from": "User", "to": "Subscription", "type": "one_to_many", "field": "owner_user_id"},
    {"from": "SubscriptionPlan", "to": "Subscription", "type": "one_to_many", "field": "plan_id"},
    {"from": "Subscription", "to": "SubscriptionAddOn", "type": "one_to_many", "field": "subscription_id"},
    {"from": "AddOn", "to": "SubscriptionAddOn", "type": "one_to_many", "field": "addon_id"},
    {"from": "Subscription", "to": "Seat", "type": "one_to_many", "field": "subscription_id"},
    {"from": "Subscription", "to": "Invitation", "type": "one_to_many", "field": "subscription_id"},
    {"from": "Subscription", "to": "PaymentTransaction", "type": "one_to_many", "field": "subscription_id"},
    {"from": "Journey", "to": "JourneyDay", "type": "one_to_many", "field": "journey_id"},
    {"from": "Module", "to": "Package", "type": "one_to_many", "field": "module_id"},
    {"from": "Ebook", "to": "EbookChapter", "type": "one_to_many", "field": "ebook_id"},
    {"from": "ContentItem", "to": "ExerciseStep", "type": "one_to_many", "field": "content_item_id"},
    {"from": "User", "to": "ContentProgress", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Comment", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Highlight", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Note", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Favorite", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Collection", "type": "one_to_many", "field": "user_id"},
    {"from": "Collection", "to": "CollectionItem", "type": "one_to_many", "field": "collection_id"},
    {"from": "User", "to": "EbookProgress", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Download", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "Achievement", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "ContentReview", "type": "one_to_many", "field": "user_id"},
    {"from": "User", "to": "CoachAssignment", "type": "one_to_many", "field": "coach_user_id"}
  ]
}
