{
  "name": "pst-coaching",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "mobile:dev": "pnpm --filter @pst-coaching/mobile dev",
    "mobile:ios": "pnpm --filter @pst-coaching/mobile ios",
    "mobile:android": "pnpm --filter @pst-coaching/mobile android",
    "mobile:web": "pnpm --filter @pst-coaching/mobile web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.0.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.0.5"
  }
}
