{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenInventory",
  "type": "object",
  "required": ["appName", "navigation", "screens"],
  "properties": {
    "appName": {"type": "string"},
    "navigation": {
      "type": "object",
      "required": ["tabs"],
      "properties": {
        "tabs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "route", "title", "type", "states"],
        "properties": {
          "id": {"type": "string"},
          "route": {"type": "string"},
          "title": {"type": "string"},
          "type": {"type": "string", "enum": ["tab", "stack", "modal", "sheet"]},
          "states": {"type": "array", "items": {"type": "string"}},
          "gates": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
