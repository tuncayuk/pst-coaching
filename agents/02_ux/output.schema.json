{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenInventory",
  "type": "object",
  "required": ["appName", "navigation", "screens"],
  "properties": {
    "appName": {"type": "string"},
    "navigation": {
      "type": "object",
      "required": ["tabs"],
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "route", "title", "type", "states"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+\\.[a-z0-9_]+$"
          },
          "route": {
            "type": "string",
            "pattern": "^/[a-z0-9\\-/:]*$"
          },
          "title": {"type": "string"},
          "type": {"type": "string", "enum": ["tab", "stack", "modal", "sheet"]},
          "states": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "loading",
                "ready",
                "empty",
                "error",
                "offline",
                "skeleton",
                "disabled"
              ]
            },
            "allOf": [
              {"contains": {"const": "loading"}},
              {"contains": {"const": "ready"}},
              {"contains": {"const": "empty"}},
              {"contains": {"const": "error"}},
              {"contains": {"const": "offline"}}
            ]
          },
          "gates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "auth",
                "subscription",
                "add_on",
                "demography",
                "ddl_test",
                "owner_role",
                "member_role",
                "coach_role"
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
